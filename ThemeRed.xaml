<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--This style used for tab item styles-->
    <Style x:Key="CustomTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <!-- Add more setters if needed -->
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="#DD5552"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Grid">
        <Setter Property="Background" Value="#F9DFDE"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#F9DFDE"/>
    </Style>
    


    <!-- Style for the TabItems -->
    <Style TargetType="TabItem" >
        <Setter Property="Background" Value="#B60400"/>
        <Setter Property="Foreground" Value="#FFFFE8"/>
        <Setter Property="FontSize" Value="12"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Name="Panel">
                        <ContentPresenter x:Name="ContentSite"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     ContentSource="Header"
                                     Margin="10,2"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Panel" Property="Background" Value="#DD5552" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="Panel" Property="Background" Value="#B60400" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Style for the TabItem's Content -->
    <Style TargetType="ContentPresenter">
        <Setter Property="Margin" Value="1"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Background" Value="#F9DFDE"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    
</ResourceDictionary>

                                        </Grid.ColumnDefinitions>

                                        <!-- Controls are now placed in specific columns -->
                                        <CheckBox Grid.Column="0" Name="chkAutoFill" Checked="chkAutoFill_Checked" Unchecked="chkAutoFill_Unchecked" Content="Enable Autofill" VerticalAlignment="Center" Margin="5,0,0,0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="97"/>



                                        <RadioButton Grid.Column="2" Name="rdoFam" Content="Single Family" GroupName="rdoSubcategory" Checked="rdoFam_Checked" VerticalAlignment="Bottom" Margin="5,0,5,9"/>

                            <Button Name="btnMainBack" Content="&lt;" Click="btnMainBack_Click" Style="{StaticResource ButtonStyle}" Grid.Column="1" Margin="1,5"/>
                            <Button Name="btnMainFwd" Content="&gt;" Click="btnMainFwd_Click" Style="{StaticResource ButtonStyle}" Grid.Column="2" Margin="3,5"/>
                            <Button Content="Drag" Name="btnTabMain" Click="btnTabMain_Click" Style="{StaticResource ButtonStyle}"  Grid.Column="3" Margin="3,5" />

                        </Grid>

                        <Grid Grid.Row="1" Margin="5,1,5,1" Grid.ColumnSpan="3">
                            <!-- Border added to group the settings controls -->
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="2">
                                <GroupBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Define columns for each control group for precise alignment -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Enable Autofill CheckBox -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Separator -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Single Family RadioButton -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Condo/TownHouse RadioButton -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Separator -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Miles Label -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Miles TextBox -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Separator -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- SqFt Label -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- SqFt TextBox -->
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <!-- Fills remaining space -->
                                        </Grid.ColumnDefinitions>


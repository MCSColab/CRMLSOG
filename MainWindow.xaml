                                        <Label Grid.Column="8" Content="SqFt +/- Range:" VerticalAlignment="Center" Margin="5,0,0,0" />
                                        <TextBox Grid.Column="9" Name="txtSqFtRange" Width="60" Text="300" VerticalAlignment="Center" LostFocus="txtSqFtRange_LostFocus" Style="{StaticResource TextBoxStyle}" />
                                        <Label Grid.Column="10" Name="lblSqFtRange" Content="(0-0)" VerticalAlignment="Center" Margin="5,0,0,0" />
                                    </Grid>
                                </GroupBox>
                            </Border>
                        </Grid>
                        <!-- WebView -->
                        <Wpf:WebView2 x:Name="WebViewComp" Grid.Row="2" Margin="10,10,10,10" Grid.ColumnSpan="5"/>
                    </Grid>

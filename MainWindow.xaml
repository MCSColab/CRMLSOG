                                        <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0" />
                                        <RadioButton Grid.Column="2" Name="rdoFam0" Content="Single Family" GroupName="rdoSubcategory" VerticalAlignment="Bottom" Margin="5,0,5,9" Checked="rdoFam0_Checked" />
                                        <RadioButton Grid.Column="3" Name="rdoCondo0" Content="Condo/TownHouse" GroupName="rdoSubcategory" VerticalAlignment="Center" Margin="5" Checked="rdoCondo0_Checked" />
                                        <Separator Grid.Column="4" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0" />
                                        <Label Grid.Column="5" Content="Miles Covered:" VerticalAlignment="Center" Margin="5,0,0,0" />
                                        <TextBox Grid.Column="6" x:Name="txtRadius0" Width="50" Text="0.25" VerticalAlignment="Center" Style="{StaticResource TextBoxStyle}" TextChanged="txtRadius0_TextChanged" />
